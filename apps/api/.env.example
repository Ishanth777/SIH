# ============================================================
# API Environment Variables
# ============================================================
# Copy to .env and fill in values. NEVER commit the .env file.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://coop_user:coop_password@localhost:6432/coop_marketplace?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT (rule S2: two separate secrets) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- OTP ----
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ---- SMS Provider ----
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- MinIO / S3 ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=coop-documents

# ---- App ----
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001

# ---- Forecasting Service ----
FORECASTING_SERVICE_URL=http://localhost:8000
