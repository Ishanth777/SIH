# ============================================================
# Cooperative Labour Marketplace — Root Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# ============================================================

# Database (Postgres 16 + PostGIS)
DATABASE_URL=postgresql://coop_user:coop_password@localhost:5432/coop_marketplace?schema=public
POSTGRES_USER=coop_user
POSTGRES_PASSWORD=coop_password
POSTGRES_DB=coop_marketplace

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible Object Storage)
MINIO_ROOT_USER=coop_minio_admin
MINIO_ROOT_PASSWORD=coop_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=coop-documents

# JWT Secrets (min 16 characters)
JWT_ACCESS_SECRET=sih26089_jwt_access_super_secret_key_2026_dev
JWT_REFRESH_SECRET=sih26089_jwt_refresh_super_secret_key_2026_dev
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# App Configuration
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Forecasting Microservice
FORECASTING_SERVICE_URL=http://localhost:8000

# Web Application
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Razorpay Payment Gateway (UPI-first, Step 11 & Step 18)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# AI & Multilingual Stack (IndicTrans2 / Bhashini / LLM)
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id
