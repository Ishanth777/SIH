# ============================================================
# Cooperative Labour Marketplace — Root Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file — it contains secrets.
# ============================================================

# ---- Database (Postgres + PostGIS) ----
DATABASE_URL=postgresql://coop_user:coop_password@localhost:6432/coop_marketplace?schema=public
POSTGRES_USER=coop_user
POSTGRES_PASSWORD=coop_password
POSTGRES_DB=coop_marketplace

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=coop-documents

# ---- JWT Secrets (use strong random strings in production) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- OTP ----
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ---- SMS Provider ----
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- App Config ----
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001

# ---- Forecasting Service ----
FORECASTING_SERVICE_URL=http://localhost:8000
