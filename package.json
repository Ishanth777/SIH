{
  "name": "coop-labour-marketplace",
  "version": "0.0.1",
  "private": true,
  "description": "Cooperative Labour Marketplace — multi-tenant platform connecting cooperative societies with workers and customers",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "api:dev": "pnpm --filter api dev",
    "api:build": "pnpm --filter api build",
    "api:test": "pnpm --filter api test",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "api:lint": "pnpm --filter api lint",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "mobile:dev": "pnpm --filter mobile start",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec -- rm -rf dist node_modules .next .expo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@nestjs/platform-express": "^10.4.15",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-native": "^0.72.8",
    "multer": "^2.3.0",
    "react": "^19.2.8",
    "react-native": "^0.87.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0"
  }
}
